# Simulated time: the kernel asks the pytest loop for every clock advance.
CONFIG_UML_TIME_TRAVEL_SUPPORT=y
# CONFIG_SMP is not set
# The serial line and console have no time-travel interrupt, so input waits
# for the next tick; a periodic tick bounds that wait to 1/HZ (10 ms).
CONFIG_HZ_PERIODIC=y
# CONFIG_NO_HZ_IDLE is not set

# The guest runs the host's programs from a read-only hostfs root and keeps
# its writable state in memory.
CONFIG_HOSTFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
# CONFIG_BLK_DEV_UBD is not set
# CONFIG_MCONSOLE is not set
# The guest's randomness comes from a fixed seed alone, not from the host's
# /dev/random, so random addresses and keys repeat on every run.
# CONFIG_UML_RANDOM is not set

# The Virtual Controller is attached to the serial line ttyS0 with btattach.
CONFIG_SSL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
