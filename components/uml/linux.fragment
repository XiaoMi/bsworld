# Simulated time: the kernel asks the pytest loop for every clock advance.
CONFIG_UML_TIME_TRAVEL_SUPPORT=y
# CONFIG_SMP is not set
# Stop the scheduling tick in idle. Incoming virtio notifications wake the guest.
# CONFIG_HZ_PERIODIC is not set
CONFIG_NO_HZ_IDLE=y

# The guest runs the host's programs from a read-only hostfs root and keeps
# its writable state in memory.
CONFIG_HOSTFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
# CONFIG_BLK_DEV_UBD is not set
# CONFIG_MCONSOLE is not set
# Disable UML's host /dev/random driver when testing with a fixed seed.
# CONFIG_UML_RANDOM is not set

# Register the virtual Controller and console directly with their guest drivers.
CONFIG_VIRTIO_UML=y
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_SSL is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_VIRTIO=y
